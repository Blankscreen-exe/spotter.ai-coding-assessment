# Copy to .env. Everything here is optional for a local run on SQLite + OSRM.

# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=

# Admin login created by "python manage.py seed_admin". Without these it uses
# the demo login admin / fuelroute-demo, and only while DJANGO_DEBUG is on.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=

# PostgreSQL and Redis. Leave unset to use SQLite and an in-process cache.
# docker compose sets both for you.
# DATABASE_URL=postgres://user:password@localhost:5432/fuelroute
# REDIS_URL=redis://localhost:6379/0

# Needed only to store an OpenRouteService API key (it is encrypted with this).
# Generate with: python manage.py generate_encryption_key
CREDENTIALS_ENCRYPTION_KEYS=

# Behind an HTTPS proxy or load balancer: redirect to https, HSTS, secure cookies.
# DJANGO_SECURE=true

# Tuning
# API_RATE_LIMIT=120/min
# ROUTE_CACHE_SECONDS=3600
# ROUTING_TIMEOUT_SECONDS=20
# OSRM_BASE_URL=https://router.project-osrm.org
# ORS_BASE_URL=https://api.openrouteservice.org
